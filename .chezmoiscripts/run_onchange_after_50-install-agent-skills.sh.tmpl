#!/usr/bin/env bash
# ABOUTME: Reinstalls the agent skills listed in ~/.agents/.skill-lock.json via the skills CLI
# ABOUTME: Skills land as directories in ~/.claude/skills alongside the hand-written ones
#
# chezmoi:onchange-hash:{{ includeTemplate "dot_agents/dot_skill-lock.json" | sha256sum }}

set -euo pipefail

if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

LOCKFILE="$HOME/.agents/.skill-lock.json"
SKILLS_DIR="$HOME/.claude/skills"

if [[ ! -f "$LOCKFILE" ]]; then
    echo "⚠ No skill lockfile at $LOCKFILE"
    echo "  Skipping agent skill restoration"
    exit 0
fi

if ! command -v jq &> /dev/null; then
    echo "⚠ jq not found. Run: brew bundle"
    echo "  Skipping agent skill restoration"
    exit 0
fi

# The skills CLI runs through npx, which comes from the node that mise provisions.
# 45-setup-mise runs before any files are applied, so on a first-ever apply it sees no
# ~/.config/mise/config.toml and installs nothing. This script runs after files are in
# place, so it can install node itself. Scope the install to node: a bare 'mise install'
# also builds unrelated tools whose failure would abort the apply.
if command -v npx &> /dev/null; then
    NPX=(npx)
elif command -v mise &> /dev/null; then
    echo "npx not on PATH; installing node via mise..."
    mise install node@lts
    NPX=(mise exec node@lts -- npx)
else
    echo "⚠ Neither npx nor mise found. Run: brew bundle && mise install"
    echo "  Skipping agent skill restoration"
    exit 0
fi

# Read the lockfile up front. jq inside $( ) or < <( ) cannot trip set -e, so a truncated
# write or a schema change would otherwise look like "zero skills" and report success.
if ! all_names=$(jq -r '.skills | keys[]' "$LOCKFILE"); then
    echo "⚠ Could not read skill names from $LOCKFILE"
    echo "  The file may be truncated, or its schema may have changed"
    exit 1
fi

if ! sources=$(jq -r '[.skills[].source] | unique | .[]' "$LOCKFILE"); then
    echo "⚠ Could not read skill sources from $LOCKFILE"
    exit 1
fi

# A skill counts as installed only if its SKILL.md is there: an interrupted install leaves
# an empty directory behind, which would otherwise be skipped forever.
installed() {
    [[ -f "$SKILLS_DIR/$1/SKILL.md" ]]
}

echo "Restoring agent skills from lockfile..."

# 'skills experimental_install' only restores a project-level skills-lock.json, not this
# global one, so reinstall per source repo. One invocation per repo, with a repeated
# --skill flag per skill: the flag takes a single name, and a comma-separated list is
# silently treated as no match.
while IFS= read -r source; do
    [[ -n "$source" ]] || continue

    args=()
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        installed "$name" || args+=(--skill "$name")
    done < <(jq -r --arg s "$source" '.skills | to_entries | map(select(.value.source == $s)) | .[].key' "$LOCKFILE")

    if [[ ${#args[@]} -eq 0 ]]; then
        echo "✓ $source: all skills already installed"
        continue
    fi

    echo "Installing $(( ${#args[@]} / 2 )) skill(s) from $source..."
    # The agent is 'claude-code'; an unrecognised name makes the CLI install nothing.
    "${NPX[@]}" -y skills add "$source" --global "${args[@]}" --agent claude-code --yes < /dev/null
done <<< "$sources"

# The CLI exits 0 even when it installs nothing, so trust the filesystem, not the status.
missing=()
count=0
while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    count=$(( count + 1 ))
    installed "$name" || missing+=("$name")
done <<< "$all_names"

if [[ ${#missing[@]} -gt 0 ]]; then
    echo "⚠ ${#missing[@]} listed skill(s) are still not installed: ${missing[*]}"
    echo "  Either the install failed (network, rate limit) - rerun 'chezmoi apply' - or the"
    echo "  skill was renamed or removed upstream. If it is gone for good, drop it with:"
    for name in "${missing[@]}"; do
        echo "    npx skills remove --global --skill $name -y"
    done
    echo "  then: chezmoi re-add ~/.agents/.skill-lock.json"
    exit 1
fi

echo "✓ All $count listed agent skills present"
